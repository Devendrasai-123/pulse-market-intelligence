# Pulse backend — copy to `.env` and fill in real values. Never commit `.env`.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=your_supabase_url_here

# Supabase anon or service key (Project Settings → API). Prefer a restricted key in production.
SUPABASE_KEY=your_supabase_key_here

# Bright Data API token for Scraper Studio / CLI-backed backend calls
BRIGHT_DATA_API_KEY=your_bright_data_key_here

# NVIDIA NIM API key used as the CrewAI inference backend
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here
