# Pulse backend — copy to `.env` and fill in real values. Never commit `.env`.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=your_supabase_url_here

# Supabase key (Project Settings → API).
# Use the service_role key for ingest scripts (bypasses RLS).
# The anon key is enough for GET /api/prices if the read policy is enabled.
SUPABASE_KEY=your_supabase_key_here

# Bright Data API token for Scraper Studio / CLI-backed backend calls.
# Also exported as BRIGHTDATA_API_KEY for the CLI when running heal.
BRIGHT_DATA_API_KEY=your_bright_data_key_here

# Price scraper (Scraper Studio) — self-heal target
PRICE_COLLECTOR_ID=c_mswww62b2iig1j1hcj
PRICE_SCRAPER_URL=https://www.coingecko.com/en
# SELF_HEAL_TIMEOUT_SEC=900

# NVIDIA NIM API key (build.nvidia.com) — used by CrewAI via LiteLLM.
# Env name expected by CrewAI/LiteLLM: NVIDIA_NIM_API_KEY
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here

# Optional: override the NIM model id (default: meta/llama-3.1-8b-instruct)
# NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Optional (Render / local): comma-separated browser origins for CORS later.
# Leave unset to allow all origins during the hackathon.
# FRONTEND_ORIGIN=https://your-app.vercel.app
